// Table lineage for the Fernhill Growers warehouse, as lineage.py writes it,
// with styling added. The colours are placeholders, swapped for CSS variables
// after rendering: #010101 ink, #FEFEFD card, #020202 accent, #030303 muted.
digraph lineage {
  graph [rankdir=LR, bgcolor="transparent", fontname="Atkinson Hyperlegible", pad=0.2, nodesep=0.35, ranksep=0.6];
  node  [shape=box, style="filled", fillcolor="#FEFEFD", color="#010101", fontcolor="#010101", fontname="Atkinson Hyperlegible Mono", fontsize=11, penwidth=1.5];
  edge  [color="#010101", fontcolor="#030303", fontname="Atkinson Hyperlegible Mono", fontsize=9, arrowsize=0.7];

  // Loaded by the shop and the growers' tablets, not by a job
  raw_harvest [style="filled,dashed", color="#030303", fontcolor="#030303"];
  raw_orders  [style="filled,dashed", color="#030303", fontcolor="#030303"];

  raw_harvest -> stage_harvest;
  raw_orders -> stage_orders;
  stage_harvest -> box_contents;
  stage_orders -> box_contents;
  box_contents -> route_plan [label="missing from after", color="#020202", fontcolor="#020202", penwidth=2];
  stage_orders -> route_plan;
  box_contents -> waste_report;
  stage_harvest -> waste_report;
}
